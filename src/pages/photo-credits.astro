---
import SiteLayout from '../layouts/SiteLayout.astro';
import { photoLibrary } from '../lib/photo-library.js';
import { requiresPublicAttribution } from '../lib/photo-attribution.mjs';
const requiredCredits = Object.entries(photoLibrary.images).filter(([, credit]) => requiresPublicAttribution(credit));
---
<SiteLayout title="Photography credits" description="Sources, photographers and reuse licences for our destination photography.">
  <section class="section"><div class="container">
    <p class="eyebrow">The places behind the photographs</p>
    <h1>Photography credits</h1>
    <p>The images below have licence terms that require visible attribution. Creator, source and licence details are listed for each. Images may be resized and cropped for display; share-alike licences continue to apply to the photographs.</p>
    <div class="credit-grid">
      {requiredCredits.map(([src, credit]) => <figure>
        <img src={src} alt={credit.alt || credit.subject} loading="lazy" width="480" height="300" />
        <figcaption><strong>{credit.subject}</strong><br />{credit.title || credit.alt}<br />{credit.creator} · <a href={credit.license_url}>{credit.license}</a><br />{credit.date && <>Photographed: {credit.date}<br /></>}<a href={credit.source_page}>Original photograph and licence</a></figcaption>
      </figure>)}
    </div>
  </div></section>
</SiteLayout>
<style>.credit-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:2rem;margin-top:2rem}.credit-grid figure{margin:0}.credit-grid img{width:100%;height:190px;object-fit:cover;border-radius:12px}.credit-grid figcaption{padding-top:.6rem;line-height:1.7}</style>
