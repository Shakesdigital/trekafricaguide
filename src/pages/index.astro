---
import SiteLayout from '../layouts/SiteLayout.astro';
import CardCarousel from '../components/CardCarousel.astro';
import ListingCard from '../components/ListingCard.astro';
import GuideSearch from '../components/GuideSearch.astro';
import DestinationTabs from '../components/DestinationTabs.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { getSiteModel } from '../lib/site-model.mjs';

const model = await getSiteModel();
const hero = model.pageSections.find((section) => section.page_key === 'home' && section.section_key === 'hero');
const featuredAttractions = [...model.attractions].sort((a, b) => Number(Boolean(b.featured)) - Number(Boolean(a.featured))).slice(0, 8);
const featuredInsights = [...model.travelArticles].sort((a, b) => Number(Boolean(b.featured)) - Number(Boolean(a.featured))).slice(0, 8);
const featuredStays = [...model.accommodations].filter((item) => item.hero_image_url).sort((a, b) => Number(Boolean(b.featured)) - Number(Boolean(a.featured))).slice(0, 8);
---
<SiteLayout model={model} title="Africa travel guide">
  <section class="hero">
    <div class="hero-carousel" data-hero-carousel>
      {(hero?.meta?.slides || [{ image_slot: 'home-hero-east-africa' }]).map((slide, index) => (
        <div class={`hero-carousel__slide ${index === 0 ? 'is-active' : ''}`} data-hero-slide>
          <ImageSlot class="hero-carousel__slot" src={`image-slot:${slide.image_slot || 'home-hero-east-africa'}`} alt={slide.title || hero?.title} />
        </div>
      ))}
    </div>
    <div class="hero__overlay"></div>
    <div class="container hero__content">
      <p class="eyebrow">{hero?.eyebrow || 'Discover Africa'}</p>
      <h1 data-hero-title>{hero?.title || 'Explore Africa with the context to choose well.'}</h1>
      <p class="hero__lead" data-hero-body>{hero?.body || 'Trek Africa Guide brings destinations, attractions, accommodations, and practical planning notes into one place.'}</p>
      <div class="hero__actions">
        <a class="button" href="/regions">Explore regions</a>
        <a class="button button--ghost-light" href="/attractions">View attractions</a>
      </div>
    </div>
  </section>
  <section class="home-intro section section--alt">
    <div class="container home-intro__grid">
      <div class="home-intro__image">
        <ImageSlot class="home-intro__slot" src="image-slot:home-intro-africa-map" alt="Waterways and islands of Botswana’s Okavango Delta" />
        <span class="home-intro__caption">A continent of distinct routes and places</span>
      </div>
      <div class="home-intro__copy">
        <p class="eyebrow">A guide to travelling Africa</p>
        <h2>Plan with a clearer sense of place.</h2>
        <p>Trek Africa Guide is an independent African travel catalogue and planning companion. Explore destinations, discover attractions and activities, and compare stays that fit your route.</p>
        <p>Use our guides to plan with context, then continue to trusted booking providers to confirm current availability, rates, inclusions, permits and terms before paying.</p>
        <a class="button" href="/about-us">Read More About Trek Africa Guide</a>
      </div>
    </div>
  </section>
  <DestinationTabs items={model.countries} label="Explore countries" minimal autoplay />

  <section class="section">
    <div class="container">
      <GuideSearch model={model} />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Featured Regions</p>
        <h2>Five useful starting points for a smarter Africa trip.</h2>
        <p>Use the regions to compare travel moods first, then narrow into destination countries, attractions, nearby stays, and booking paths.</p>
      </div>
      <CardCarousel label="Featured regions" regions>
        {model.regions.map((region) => (
          <article class="region-card">
            <a href={`/regions/${region.slug}`}><ImageSlot class="region-card__slot" src={region.hero_image_url} alt={region.hero_image_alt || region.name} /></a>
            <div class="region-card__content">
              <p class="eyebrow">{region.name}</p>
              <h3><a href={`/regions/${region.slug}`}>{region.hero_title || region.name}</a></h3>
              <p>{region.hero_text || region.overview}</p>
              <a class="button" href={`/regions/${region.slug}`}>View region</a>
            </div>
          </article>
        ))}
      </CardCarousel>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Featured Attractions</p>
        <h2>Attractions that can become the anchor of the journey.</h2>
      </div>
      <CardCarousel label="Featured attractions">
        {featuredAttractions.map((item) => <ListingCard item={item} type="attraction" />)}
      </CardCarousel>
      <div class="section-cta"><a class="button button--ghost" href="/attractions" aria-label="View more attractions">View More</a></div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Featured Stays</p>
        <h2>Stays chosen for how they support the route.</h2>
      </div>
      <CardCarousel label="Featured stays">
        {featuredStays.map((item) => <ListingCard item={item} type="accommodation" />)}
      </CardCarousel>
      <div class="section-cta"><a class="button button--ghost" href="/accommodations" aria-label="View more stays">View More</a></div>
    </div>
  </section>
  {featuredInsights.length > 0 && <section class="section"><div class="container">
    <div class="section-heading"><p class="eyebrow">Featured Travel Insights</p><h2>Ideas and practical advice for your next journey.</h2></div>
    <CardCarousel label="Featured travel insights">{featuredInsights.map((item) => <ListingCard item={item} type="insight" />)}</CardCarousel>
    <div class="section-cta"><a class="button button--ghost" href="/travel-insights" aria-label="View more travel insights">View More</a></div>
  </div></section>}
</SiteLayout>
