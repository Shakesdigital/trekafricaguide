---
import EditorialText from '../../components/EditorialText.astro';
import ResearchNotes from '../../components/ResearchNotes.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Gallery from '../../components/Gallery.astro';
import ListingCard from '../../components/ListingCard.astro';
import BookingOffers from '../../components/BookingOffers.astro';
import { getSiteModel } from '../../lib/site-model.mjs';
import { normalizeList } from '../../lib/images.mjs';
import { photoContext } from '../../lib/photo-defaults.mjs';

export async function getStaticPaths() {
  const model = await getSiteModel();
  return model.accommodations.map((accommodation) => ({ params: { slug: accommodation.slug }, props: { accommodation } }));
}

const model = await getSiteModel();
const { accommodation } = Astro.props;
---
<SiteLayout model={model} title={accommodation.name} description={accommodation.listing_summary || accommodation.detail_intro}>
  <section class="detail-hero">
    <div class="container">
      <Breadcrumbs items={[{ label: accommodation.region.name, href: `/regions/${accommodation.region.slug}` }, { label: accommodation.country.name, href: `/countries/${accommodation.country.slug}` }, { label: accommodation.name }]} />
      <div class="listing-head">
        <p class="eyebrow">{accommodation.name} · {accommodation.location_name}, {accommodation.country.name}</p>
        <h1>{accommodation.name}</h1>
        
      </div>
      <Gallery images={normalizeList(accommodation.gallery).length ? normalizeList(accommodation.gallery) : [accommodation.hero_image_url]} alt={accommodation.name} caption={photoContext(accommodation.hero_image_url)} />
      
    </div>
  </section>
  <section class="section">
    <div class="container detail-grid">
      <div class="detail-main">
        <div class="detail-section"><EditorialText text={accommodation.detail_intro || accommodation.listing_summary} class="detail-hero__summary" /></div>
        <div class="detail-section"><h2>Why stay here and how to plan your stay</h2><EditorialText text={accommodation.listing_summary} /><EditorialText text={accommodation.practical_info} /></div>
        <div class="detail-section"><h2>Key amenities</h2><ul class="amenity-grid">{normalizeList(accommodation.amenities).map((item) => <li class="amenity">{item}</li>)}</ul></div>
        {(accommodation.property_type || accommodation.price_label) && <div class="detail-section"><h2>Stay style and budget</h2><p>{accommodation.property_type}</p>{accommodation.price_label && <p><strong>Price category: {accommodation.price_label}.</strong> This describes general positioning; ask the property for current rates, seasonal changes and what is included.</p>}</div>}
        <ResearchNotes record={accommodation} />
        {accommodation.attraction && <div class="detail-section"><h2>Related attraction</h2><div class="related-card-grid"><ListingCard item={accommodation.attraction} type="attraction" /></div></div>}
      </div>
      <aside class="detail-rail"><BookingOffers listing={accommodation} offers={accommodation.bookingOffers} /></aside>
    </div>
  </section>
  <section class="section section--alt"><div class="container"><h2>Nearby attractions</h2><div class="listing-grid">{accommodation.nearbyAttractions.map((item) => <ListingCard item={item} type="attraction" />)}</div></div></section>
</SiteLayout>
