---
import DirectoryFilters from '../../components/DirectoryFilters.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ListingCard from '../../components/ListingCard.astro';
import { getSiteModel } from '../../lib/site-model.mjs';
const model = await getSiteModel();
---
<SiteLayout model={model} title="Accommodations">
  <PageHero eyebrow="Accommodations" title="Stays that support the route." text="Review lodging by attraction fit, country, property type, and practical planning value." image="image-slot:accommodations-index-hero" />
  <section class="section">
    <div class="container" data-directory="accommodations">
      <DirectoryFilters model={model} kind="accommodations" types={[...new Set(model.accommodations.map(item => item.property_type).filter(Boolean))].sort()} />
      <div class="listing-grid">
        {model.accommodations.map((item) => <ListingCard item={item} type="accommodation" />)}
      </div>
    </div>
  </section>
</SiteLayout>
