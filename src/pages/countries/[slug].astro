---
import EditorialText from '../../components/EditorialText.astro';
import ResearchNotes from '../../components/ResearchNotes.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { normalizeList } from '../../lib/images.mjs';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CardCarousel from '../../components/CardCarousel.astro';
import ListingCard from '../../components/ListingCard.astro';
import Gallery from '../../components/Gallery.astro';
import { getSiteModel } from '../../lib/site-model.mjs';

export async function getStaticPaths() {
  const model = await getSiteModel();
  return model.countries.map((country) => ({ params: { slug: country.slug }, props: { country } }));
}

const model = await getSiteModel();
const { country } = Astro.props;
const attractions = model.attractions.filter((item) => item.country_id === country.id);
const stays = model.accommodations.filter((item) => item.country_id === country.id);
---
<SiteLayout model={model} title={country.name} description={country.hero_text || country.overview}>
  <section class="detail-hero"><div class="container">
    <Breadcrumbs items={[{ label: country.region.name, href: `/regions/${country.region.slug}` }, { label: country.name }]} />
    <div class="listing-head"><p class="eyebrow">Destination guide</p><h1>{country.hero_title || country.name}</h1></div>
    <Gallery images={normalizeList(country.gallery).length ? normalizeList(country.gallery) : [country.hero_image_url]} alt={country.hero_image_alt || country.name} />
    <EditorialText text={country.hero_text} class="detail-hero__summary" />
  </div></section>
  <section class="section">
    <div class="container detail-grid">
      <div class="detail-main">
        <div class="detail-section"><h2>Destination guide</h2><EditorialText text={country.overview} /></div>
        <div class="detail-section"><h2>Getting around</h2><EditorialText text={country.access_summary} /></div>
        <div class="detail-section"><h2>Best time</h2><EditorialText text={country.best_time} /></div>
        <div class="detail-section"><h2>Planning notes</h2><EditorialText text={country.planning_tips} /></div>
        <ResearchNotes record={country} />
      </div>
      <aside class="detail-rail"><div class="info-panel"><p class="eyebrow">Region</p><h3><a href={`/regions/${country.region.slug}`}>{country.region.name}</a></h3></div></aside>
    </div>
  </section>
  <section class="section section--alt"><div class="container"><h2>Attractions in {country.name}</h2><CardCarousel>{attractions.map((item) => <ListingCard item={item} type="attraction" />)}</CardCarousel></div></section>
  <section class="section"><div class="container"><h2>Nearby stays</h2><CardCarousel label="Nearby stays">{stays.map((item) => <ListingCard item={item} type="accommodation" />)}</CardCarousel></div></section>
</SiteLayout>
