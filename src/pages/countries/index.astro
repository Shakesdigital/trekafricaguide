---
import DirectoryFilters from '../../components/DirectoryFilters.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import ListingCard from '../../components/ListingCard.astro';
import CardCarousel from '../../components/CardCarousel.astro';
import DestinationTabs from '../../components/DestinationTabs.astro';
import { getSiteModel } from '../../lib/site-model.mjs';
const model = await getSiteModel();
---
<SiteLayout model={model} title="Destinations">
  <PageHero eyebrow="Destinations" title="Country guides for choosing the right route." text="Start with fit, access, timing, and the attractions each country does best." image="image-slot:destinations-index-hero" />
  <DestinationTabs items={model.countries} label="Explore countries" minimal autoplay />
  <section class="section">
    <div class="container" data-directory="countries">
      <DirectoryFilters model={model} kind="countries" />
      <div class="listing-grid">
        {model.countries.map((country) => (
          <article class="listing-card" data-directory-item data-region={country.region.slug} data-search={[country.name, country.hero_title, country.hero_text, country.overview, country.region.name].filter(Boolean).join(" ")}>
            <a class="listing-card__image" href={`/countries/${country.slug}`}><ImageSlot class="listing-card__slot" src={country.hero_image_url} alt={country.hero_image_alt || country.name} /></a>
            <div class="listing-card__body">
              <p class="listing-card__eyebrow">{country.name} · {country.region.name}</p>
              <h3><a href={`/countries/${country.slug}`}>{country.hero_title || country.name}</a></h3>
              <p>{country.hero_text || country.overview}</p>
              <div class="listing-card__footer"><a class="button" href={`/countries/${country.slug}`}>View destination</a></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  {model.localDestinations.length > 0 && <section class="section section--alt"><div class="container"><h2>Cities, areas and islands to explore</h2><p>Open a local guide for attractions, things to do and places to stay within each country.</p><CardCarousel label="Local destination guides">{model.localDestinations.map((item) => <ListingCard item={item} type="destination" />)}</CardCarousel></div></section>}
</SiteLayout>
