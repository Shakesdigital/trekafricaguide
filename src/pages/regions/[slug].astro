---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ListingCard from '../../components/ListingCard.astro';
import { getSiteModel } from '../../lib/site-model.mjs';

export async function getStaticPaths() {
  const model = await getSiteModel();
  return model.regions.map((region) => ({ params: { slug: region.slug }, props: { region } }));
}

const model = await getSiteModel();
const { region } = Astro.props;
const countries = model.countries.filter((country) => country.region_id === region.id);
const attractions = model.attractions.filter((item) => item.region_id === region.id).slice(0, 6);
const stays = model.accommodations.filter((item) => item.region_id === region.id).slice(0, 6);
---
<SiteLayout model={model} title={region.name} description={region.hero_text || region.overview}>
  <PageHero eyebrow="Region" title={region.hero_title || region.name} text={region.hero_text || region.overview} image={region.hero_image_url} alt={region.hero_image_alt || region.name} />
  <section class="section">
    <div class="container two-column">
      <div class="info-panel">
        <h2>Regional overview</h2>
        <p>{region.overview}</p>
      </div>
      <div class="info-panel">
        <h2>Countries to compare</h2>
        <ul class="bullet-list">{countries.map((country) => <li><a href={`/countries/${country.slug}`}>{country.name}</a></li>)}</ul>
      </div>
    </div>
  </section>
  <section class="section section--alt"><div class="container"><h2>Attractions</h2><div class="listing-grid">{attractions.map((item) => <ListingCard item={item} type="attraction" />)}</div></div></section>
  <section class="section"><div class="container"><h2>Stays</h2><div class="listing-grid">{stays.map((item) => <ListingCard item={item} type="accommodation" />)}</div></div></section>
</SiteLayout>
