---
import BookingOffers from '../../components/BookingOffers.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Gallery from '../../components/Gallery.astro';
import CardCarousel from '../../components/CardCarousel.astro';
import ListingCard from '../../components/ListingCard.astro';
import { getSiteModel } from '../../lib/site-model.mjs';
import { normalizeList } from '../../lib/images.mjs';
import { linkAttractionMentions } from '../../lib/editorial-links.mjs';
const model = await getSiteModel();
export async function getStaticPaths() {
  const model = await getSiteModel();
  return model.activities.map((activity) => ({ params: { slug: activity.slug }, props: { activity } }));
}
const { activity } = Astro.props;
const relatedActivities = model.activities
  .filter((item) => item.slug !== activity.slug && item.country.id === activity.country.id)
  .sort((a, b) => Number(b.attraction_id === activity.attraction_id) - Number(a.attraction_id === activity.attraction_id));
const activityText = (value) => linkAttractionMentions(value, model.attractions);
---
<SiteLayout model={model} title={activity.meta_title || activity.name} description={activity.meta_description || activity.listing_summary} image={activity.meta_image_url || activity.hero_image_url}>
  <section class="detail-hero"><div class="container">
    <Breadcrumbs items={[{ label: activity.country.name, href: `/countries/${activity.country.slug}` }, { label: activity.attraction.name, href: activity.attraction.internalUrl }, { label: activity.name }]} />
    <div class="listing-head"><p class="eyebrow">{activity.attraction.name} · {activity.country.name}</p><h1>{activity.name}</h1></div>
    <Gallery images={normalizeList(activity.gallery).length ? normalizeList(activity.gallery) : [activity.hero_image_url]} alt={activity.name} />
      
  </div></section>
  <section class="section"><div class="container detail-grid"><div class="detail-main">
        <div class="detail-section"><p class="detail-hero__summary">{activity.listing_summary}</p></div>
    <div class="detail-section"><h2>About this activity</h2><div class="rich-text" set:html={activityText(activity.full_description || activity.detail_intro || '')} /></div>
    <div class="detail-section"><h2>Highlights</h2><ul class="check-list">{normalizeList(activity.highlights).map((item) => <li>{item}</li>)}</ul></div>
    <div class="detail-section"><h2>Best time to participate</h2><div class="rich-text" set:html={activityText(activity.best_time || '')} /></div>
    <div class="detail-section"><h2>Planning notes</h2><div class="rich-text" set:html={activityText(activity.practical_info || '')} /></div>
  </div><aside class="detail-rail"><BookingOffers listing={activity} offers={activity.bookingOffers} /></aside></div></section>
  {relatedActivities.length > 0 && <section class="section section--alt"><div class="container"><h2>You may also like</h2><CardCarousel label="You may also like">{relatedActivities.map((item) => <ListingCard item={item} type="activity" />)}</CardCarousel></div></section>}
  <section class="section section--alt"><div class="container"><h2>Nearby stays</h2><CardCarousel label="Nearby stays">{activity.attraction.nearbyStays.map((item) => <ListingCard item={item} type="accommodation" />)}</CardCarousel></div></section>
</SiteLayout>
