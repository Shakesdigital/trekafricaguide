---
import '../styles/app.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import siteScript from '../scripts/site.js?url';
import { DEFAULT_BRAND, STAY22_SCRIPT_ID, SITE_URL } from '../config/site.mjs';
import { getSiteModel } from '../lib/site-model.mjs';

// The script ID is distinct from the affiliate aid used in booking URLs.
const model = Astro.props.model || await getSiteModel();
const settings = model.settings || {};
const brand = {
  name: settings['general.site_name'] || DEFAULT_BRAND.name,
  tagline: settings['general.site_tagline'] || DEFAULT_BRAND.tagline,
  primary: settings['branding.primary_color'] || DEFAULT_BRAND.primary,
  secondary: settings['branding.secondary_color'] || DEFAULT_BRAND.secondary,
  accent: settings['branding.accent_color'] || DEFAULT_BRAND.accent,
  logo: settings['branding.logo_path'] || DEFAULT_BRAND.logo,
};
const title = Astro.props.title ? `${Astro.props.title} | ${brand.name}` : brand.name;
const description = Astro.props.description || settings['seo.default_meta_description'] || DEFAULT_BRAND.tagline;
const canonical = Astro.props.canonical || new URL(Astro.url.pathname, SITE_URL).toString();
const image = Astro.props.image || settings['seo.default_og_image'];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-ZWBZRQPBK7"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-ZWBZRQPBK7');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/png" href={brand.logo} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <style is:inline set:html={`:root { --brand-primary: ${brand.primary}; --brand-secondary: ${brand.secondary}; --brand-accent: ${brand.accent}; }`}></style>
    <!-- Stay22 LetMeAllez affiliate tracking — injects partner widgets on booking pages.
         lmaID is the publishable affiliate identifier (public value only; no secret keys).
         Async script tag so it never blocks page render. -->
    <script is:inline define:vars={{ lmaID: STAY22_SCRIPT_ID }}>
      (function (s, t, a, y, twenty, two) {
        s.Stay22 = s.Stay22 || {};
        s.Stay22.params = { lmaID: lmaID };
        twenty = t.createElement(a);
        two = t.getElementsByTagName(a)[0];
        twenty.async = 1;
        twenty.src = y;
        two.parentNode.insertBefore(twenty, two);
      })(window, document, 'script', 'https://lma.stay22.com/letmeallez.js');
    </script>
    <script is:inline define:vars={{ suggestions: JSON.stringify(model.searchSuggestions || []) }}>
      window.trekSearchSuggestions = JSON.parse(suggestions);
    </script>
  </head>
  <body>
    <Header brand={brand} activePath={Astro.url.pathname} />
    <main>
      <slot />
    </main>
    <Footer brand={brand} regions={model.regions} />
    <script type="module" src={siteScript}></script>
    <script is:inline type="module" src="/directory-filters.js"></script>
  </body>
</html>
