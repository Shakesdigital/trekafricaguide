---
const { model } = Astro.props;
const groups = [
  ['Country', model.countries], ['Destination', model.localDestinations || []], ['Attraction', model.attractions],
  ['Activity', model.activities], ['Accommodation', model.accommodations],
  ['Travel insight', model.travelArticles]
];
const entries = groups.flatMap(([type, rows]) => rows.map((item) => ({
  title: item.name || item.title, url: item.internalUrl, type,
  context: [item.country?.name || (typeof item.country === 'string' ? item.country : ''), item.region?.name, item.location_name].filter(Boolean).join(' · '),
  keywords: [item.name, item.title, item.listing_summary, item.excerpt, item.overview, item.country?.name, item.region?.name, item.location_name].filter(Boolean).join(' ').replace(/<[^>]*>/g, ' ')
})));
---
<section class="guide-search" aria-label="Search Trek Africa Guide" data-guide-search>
  <form class="guide-search__form" role="search">
    <label for="guide-search-query">Where would you like to explore?
      <input id="guide-search-query" name="q" type="search" placeholder="Search destinations, attractions, activities, stays and insights" />
    </label>
    <button class="button" type="submit">Search guides</button>
  </form>
  <p data-guide-status role="status" hidden></p>
  <ul class="guide-search__results" data-guide-results hidden>
    {entries.map((entry) => <li data-guide-entry data-keywords={entry.keywords.toLocaleLowerCase()}>
      <a href={entry.url}><small>{entry.type}{entry.context ? ` · ${entry.context}` : ''}</small><strong>{entry.title}</strong></a>
    </li>)}
  </ul>
  <noscript><p>Explore <a href="/countries">destinations</a>, <a href="/attractions">attractions</a>, <a href="/activities">activities</a>, <a href="/accommodations">accommodations</a> and <a href="/travel-insights">travel insights</a>.</p></noscript>
</section>
<script>
  document.querySelectorAll('[data-guide-search]').forEach((search) => {
    const form = search.querySelector('form');
    const input = search.querySelector('input');
    const results = search.querySelector('[data-guide-results]');
    const status = search.querySelector('[data-guide-status]');
    const entries = [...search.querySelectorAll<HTMLElement>('[data-guide-entry]')];
    const update = () => {
      const words = input.value.trim().toLocaleLowerCase().split(/\s+/).filter(Boolean);
      let count = 0;
      entries.forEach((entry) => {
        const match = words.length > 0 && words.every((word) => entry.dataset.keywords.includes(word));
        entry.hidden = !match;
        if (match) count++;
      });
      results.hidden = count === 0;
      status.hidden = false;
      status.textContent = !words.length ? 'Enter a place, activity or topic to find a guide.' : count ? `${count} ${count === 1 ? 'guide' : 'guides'} found` : 'No guides found. Try a country, place name or a broader topic.';
    };
    form.addEventListener('submit', (event) => { event.preventDefault(); update(); });
    input.addEventListener('input', update);
  });
</script>
