---
const { brand, regions = [] } = Astro.props;
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <h3>{brand.name}</h3>
    </div>
    <div>
      <h4>Explore</h4>
      <ul>
        <li><a href="/countries">Destinations</a></li>
        <li><a href="/attractions">Attractions</a></li>
        <li><a href="/activities">Activities</a></li>
        <li><a href="/accommodations">Accommodations</a></li>
        <li><a href="/travel-insights">Travel Insights</a></li>
        <li><a href="/about-us">About Trek Africa Guide</a></li>
      </ul>
    </div>
    <div>
      <h4>Planning Focus</h4>
      <ul>
        {regions.map((region) => <li><a href={`/regions/${region.slug}`}>{region.name}</a></li>)}
      </ul>
    </div>
  </div>
</footer>
