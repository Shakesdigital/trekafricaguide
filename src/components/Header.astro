---
const { brand, activePath = '/' } = Astro.props;
const navItems = [
  ['Home', '/'],
  ['Destinations', '/countries'],
  ['Attractions', '/attractions'],
  ['Activities', '/activities'],
  ['Accommodations', '/accommodations'],
  ['Travel Insights', '/travel-insights'],
];
---
<div class="site-topline">
  <div class="container site-topline__inner">
    <form class="topline-search" role="search" autocomplete="off" data-topline-search>
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <circle cx="10.5" cy="10.5" r="7"></circle>
        <path d="M15.9 15.9 21 21"></path>
      </svg>
      <input type="search" name="q" placeholder="Planning a visit to Africa, Start Here ...." aria-label="Search Trek Africa Guide" data-topline-input aria-expanded="false" />
      <ul data-topline-results hidden></ul>
    </form>
    <span class="topline-tagline">Find inspiration, discover attractions, destination guides, and stays across Africa</span>
  </div>
</div>
<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand">
      <img src={brand.logo} alt="Trek Africa Guide logo" />
      <span>
        <strong>{brand.name}</strong>
      </span>
    </a>
    <button class="menu-toggle" type="button" data-nav-toggle aria-label="Toggle navigation" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <nav class="site-nav" data-nav-menu>
      {navItems.map(([label, href]) => <a href={href} class={(activePath === href || activePath.startsWith(href + '/')) ? 'is-active' : ''}>{label}</a>)}
    </nav>
  </div>
</header>
